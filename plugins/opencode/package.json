{
  "name": "headroom-opencode",
  "version": "0.43.1",
  "description": "Headroom proxy integration plugin for OpenCode - routes LLM traffic through the Headroom proxy for token compression",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "hook-shim",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "build:standalone": "tsup --config tsup.standalone.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.19.5",
    "headroom-ai": "0.42.0"
  },
  "peerDependencies": {
    "@ai-sdk/openai-compatible": "*",
    "@ai-sdk/provider": "*",
    "ai": "*"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/openai-compatible": {
      "optional": true
    },
    "@ai-sdk/provider": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/plugin": "2.2.5",
    "@types/node": "26.6.6",
    "@typescript/native": "npm:typescript@6.0.3",
    "tsup": "9.0.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "overrides": {
    "esbuild": "0.28.2",
    "glob": "14.0.3",
    "minimatch": "11.0.3",
    "zod": "4.6.7",
    "toml": "5.0.1"
  },
  "license": "Apache-2.0"
}
